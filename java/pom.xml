<?xml version="1.0" encoding="UTF-8"?>
<!-- The Java client for `fastbrowse serve`. Its version is the release's, which scripts/npm_versions.py keeps in step. -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>dev.agentlabs</groupId>
  <artifactId>fastbrowse</artifactId>
  <version>0.9.1</version>
  <packaging>jar</packaging>

  <name>fastbrowse</name>
  <description>A browser agent that picks instead of generating: cited answers, structured output, and credentials and authorization held in code.</description>
  <url>https://github.com/agent-labs-dev/fastbrowse</url>
  <licenses>
    <license>
      <name>MIT</name>
      <url>https://github.com/agent-labs-dev/fastbrowse/blob/main/LICENSE</url>
    </license>
  </licenses>
  <developers>
    <developer>
      <name>agent-labs-dev</name>
      <url>https://github.com/agent-labs-dev</url>
    </developer>
  </developers>
  <scm>
    <url>https://github.com/agent-labs-dev/fastbrowse</url>
    <connection>scm:git:https://github.com/agent-labs-dev/fastbrowse.git</connection>
  </scm>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Where the release stages each platform's binary, one directory per `natives-<target>` jar. -->
    <natives>${project.build.directory}/natives</natives>
  </properties>

  <dependencies>
    <dependency>
      <groupId>tools.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>3.2.4</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>6.1.3</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <!-- version.properties carries the project version, which keys the cache a bundled binary is unpacked into. -->
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.16.0</version>
        <configuration>
          <compilerArgs><arg>-Xlint:all</arg><arg>-Werror</arg></compilerArgs>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.6.1</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.5.1</version>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      The release: sources, javadoc, one `natives-<target>` jar per platform from the binaries staged under ${natives},
      all signed and sent to Maven Central. `mvn -P release deploy` from the release workflow.
    -->
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <version>3.4.0</version>
            <executions>
              <execution><id>sources</id><goals><goal>jar-no-fork</goal></goals></execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <version>3.12.0</version>
            <configuration><doclint>none</doclint></configuration>
            <executions>
              <execution><id>javadoc</id><goals><goal>jar</goal></goals></execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-jar-plugin</artifactId>
            <executions>
              <execution>
                <id>natives-darwin-arm64</id><phase>package</phase><goals><goal>jar</goal></goals>
                <configuration><classifier>natives-darwin-arm64</classifier><classesDirectory>${natives}/darwin-arm64</classesDirectory></configuration>
              </execution>
              <execution>
                <id>natives-darwin-x64</id><phase>package</phase><goals><goal>jar</goal></goals>
                <configuration><classifier>natives-darwin-x64</classifier><classesDirectory>${natives}/darwin-x64</classesDirectory></configuration>
              </execution>
              <execution>
                <id>natives-linux-arm64</id><phase>package</phase><goals><goal>jar</goal></goals>
                <configuration><classifier>natives-linux-arm64</classifier><classesDirectory>${natives}/linux-arm64</classesDirectory></configuration>
              </execution>
              <execution>
                <id>natives-linux-x64</id><phase>package</phase><goals><goal>jar</goal></goals>
                <configuration><classifier>natives-linux-x64</classifier><classesDirectory>${natives}/linux-x64</classesDirectory></configuration>
              </execution>
              <execution>
                <id>natives-win32-x64</id><phase>package</phase><goals><goal>jar</goal></goals>
                <configuration><classifier>natives-win32-x64</classifier><classesDirectory>${natives}/win32-x64</classesDirectory></configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>3.2.8</version>
            <configuration><bestPractices>true</bestPractices></configuration>
            <executions>
              <execution><id>sign</id><phase>verify</phase><goals><goal>sign</goal></goals></execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>0.12.0</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <autoPublish>true</autoPublish>
              <waitUntil>published</waitUntil>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
