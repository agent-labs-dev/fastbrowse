{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "files": {
    "includes": [
      "crates/fastbrowse-browser/js/capture.js",
      "crates/fastbrowse-browser/js/snapshot.js",
      "packages/sdk/**/*.ts",
      "!packages/sdk/dist",
      "!packages/sdk/src/protocol.ts"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "arrowParentheses": "asNeeded"
    }
  },
  "assist": {
    "enabled": false
  },
  "linter": {
    "rules": {
      "preset": "none",
      "correctness": {
        "noConstAssign": "error",
        "noInvalidBuiltinInstantiation": "error",
        "noUnreachable": "error",
        "noUnsafeFinally": "error",
        "useIsNan": "error",
        "useValidForDirection": "error"
      },
      "suspicious": {
        "noDebugger": "error",
        "noDuplicateCase": "error",
        "noDuplicateObjectKeys": "error",
        "noShadowRestrictedNames": "error"
      }
    }
  }
}
