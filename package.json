{
  "name": "fastbrowse-dev",
  "private": true,
  "workspaces": [
    "packages/sdk"
  ],
  "scripts": {
    "check:browser": "biome ci src/fastbrowse/browser/capture.js src/fastbrowse/browser/snapshot.js",
