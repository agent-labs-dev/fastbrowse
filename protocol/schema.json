{
  "$defs": {
    "Artifact": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/ArtifactKind"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "mime_type": {
          "title": "Mime Type",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        },
        "uri": {
          "description": "Reference returned by the caller's `ArtifactSink`; fastbrowse never keeps bytes past the run.",
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "name",
        "mime_type",
        "size_bytes",
        "sha256",
        "uri"
      ],
      "title": "Artifact",
      "type": "object"
    },
    "ArtifactKind": {
      "enum": [
        "download"
      ],
      "title": "ArtifactKind",
      "type": "string"
    },
    "Authorization": {
      "additionalProperties": false,
      "properties": {
        "irreversible_actions": {
          "default": false,
          "description": "Allow submit/pay/delete/send style actions without pausing for confirmation.",
          "title": "Irreversible Actions",
          "type": "boolean"
        }
      },
      "title": "Authorization",
      "type": "object"
    },
    "BrowserEvent": {
      "additionalProperties": false,
      "description": "Sent once, when the browser is open and before the first step.",
      "properties": {
        "type": {
          "const": "browser",
          "default": "browser",
          "title": "Type",
          "type": "string"
        },
        "live_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Where a cloud browser can be watched live; None for local Chrome.",
          "title": "Live Url"
        },
        "browser_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The cloud browser's id, for a caller that may have to stop it out of band. None when the run did not\nstart a browser of its own (local Chrome, or one handed over through `cdp_url`).",
          "title": "Browser Id"
        }
      },
      "required": [
        "type",
        "live_url",
        "browser_id"
      ],
      "title": "BrowserEvent",
      "type": "object"
    },
    "BudgetStop": {
      "additionalProperties": false,
      "properties": {
        "resource": {
          "enum": [
            "steps",
            "dollars",
            "seconds",
            "jev_calls",
            "llm_calls"
          ],
          "title": "Resource",
          "type": "string"
        },
        "limit": {
          "title": "Limit",
          "type": "number"
        }
      },
      "required": [
        "resource",
        "limit"
      ],
      "title": "BudgetStop",
      "type": "object"
    },
    "Citation": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "The number used by this fact's links in the answer, stable within a run.",
          "minimum": 1,
          "title": "Id",
          "type": "integer"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "requirement_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Requirement Id"
        },
        "url": {
          "title": "Url",
          "type": "string"
        },
        "quote": {
          "title": "Quote",
          "type": "string"
        },
        "deep_link": {
          "title": "Deep Link",
          "type": "string"
        }
      },
      "required": [
        "id",
        "text",
        "requirement_id",
        "url",
        "quote",
        "deep_link"
      ],
      "title": "Citation",
      "type": "object"
    },
    "CostBasis": {
      "enum": [
        "metered",
        "estimated",
        "bounded",
        "unsettled",
        "unknown"
      ],
      "title": "CostBasis",
      "type": "string"
    },
    "CostBreakdown": {
      "additionalProperties": false,
      "properties": {
        "lines": {
          "default": [],
          "items": {
            "$ref": "#/$defs/CostLine"
          },
          "title": "Lines",
          "type": "array"
        }
      },
      "required": [
        "lines"
      ],
      "title": "CostBreakdown",
      "type": "object"
    },
    "CostComponent": {
      "enum": [
        "jev",
        "llm",
        "browser",
        "proxy"
      ],
      "title": "CostComponent",
      "type": "string"
    },
    "CostLine": {
      "additionalProperties": false,
      "properties": {
        "component": {
          "$ref": "#/$defs/CostComponent"
        },
        "basis": {
          "$ref": "#/$defs/CostBasis"
        },
        "dollars": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dollars"
        },
        "purpose": {
          "anyOf": [
            {
              "$ref": "#/$defs/LLMPurpose"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "input_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Wall time of the call, retries included. None for a line that is not one call, such as browser time.",
          "title": "Seconds"
        }
      },
      "required": [
        "component",
        "basis",
        "dollars",
        "purpose",
        "input_tokens",
        "output_tokens",
        "seconds"
      ],
      "title": "CostLine",
      "type": "object"
    },
    "Decider": {
      "description": "Who chose a step: Jev, the LLM (a recovery or a reader that named it), or a rule in code, such as the\nnext page of a list or DONE once a lookup is answered.",
      "enum": [
        "jev",
        "llm",
        "code"
      ],
      "title": "Decider",
      "type": "string"
    },
    "Error": {
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "Error",
      "type": "object"
    },
    "ErrorCode": {
      "description": "Every code an error reply can carry: the JSON-RPC standard ones, then this protocol's own.",
      "enum": [
        -32700,
        -32600,
        -32601,
        -32602,
        -32603,
        -32001,
        -32002,
        -32003,
        -32004
      ],
      "title": "ErrorCode",
      "type": "integer"
    },
    "ErrorResponse": {
      "properties": {
        "jsonrpc": {
          "const": "2.0",
          "default": "2.0",
          "title": "Jsonrpc",
          "type": "string"
        },
        "id": {
          "anyOf": [
            {
              "$ref": "#/$defs/RequestId"
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "$ref": "#/$defs/Error"
        }
      },
      "required": [
        "jsonrpc",
        "id",
        "error"
      ],
      "title": "ErrorResponse",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        },
        "frame_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Frame Id"
        },
        "captured_at": {
          "format": "date-time",
          "title": "Captured At",
          "type": "string"
        },
        "capture_sha256": {
          "title": "Capture Sha256",
          "type": "string"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "minimum": 0,
          "title": "End",
          "type": "integer"
        },
        "quote": {
          "title": "Quote",
          "type": "string"
        },
        "complete_source": {
          "default": false,
          "description": "The quote covers an entire downloaded text file, apart from surrounding whitespace.",
          "title": "Complete Source",
          "type": "boolean"
        },
        "control_context": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceControl"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "rendered_text": {
          "default": true,
          "description": "False for typed DOM observations whose quote is not literal rendered page text.",
          "title": "Rendered Text",
          "type": "boolean"
        },
        "heading_path": {
          "default": [],
          "description": "The headings the quote sits under on the page: which record a bare \"£10.69\" is the price of.",
          "items": {
            "type": "string"
          },
          "title": "Heading Path",
          "type": "array"
        }
      },
      "required": [
        "source_id",
        "url",
        "frame_id",
        "captured_at",
        "capture_sha256",
        "start",
        "end",
        "quote",
        "complete_source",
        "control_context",
        "rendered_text",
        "heading_path"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "FactReader": {
      "enum": [
        "jev_choice",
        "llm"
      ],
      "title": "FactReader",
      "type": "string"
    },
    "InitializeParams": {
      "description": "The client's side of the handshake.\n\nUnknown fields are allowed here and nowhere else: a client on a later protocol may send some, and it has to\nget the server's version back to report the mismatch, which a refusal of its params would hide.",
      "properties": {
        "protocol_version": {
          "title": "Protocol Version",
          "type": "integer"
        }
      },
      "required": [
        "protocol_version"
      ],
      "title": "InitializeParams",
      "type": "object"
    },
    "InitializeResult": {
      "properties": {
        "protocol_version": {
          "title": "Protocol Version",
          "type": "integer"
        },
        "fastbrowse_version": {
          "title": "Fastbrowse Version",
          "type": "string"
        }
      },
      "required": [
        "protocol_version",
        "fastbrowse_version"
      ],
      "title": "InitializeResult",
      "type": "object"
    },
    "JsonValue": {},
    "LLMPurpose": {
      "enum": [
        "plan",
        "read",
        "field_text",
        "recover",
        "compose",
        "shortcut"
      ],
      "title": "LLMPurpose",
      "type": "string"
    },
    "Limits": {
      "additionalProperties": false,
      "properties": {
        "max_steps": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Steps that reached the page. A click whose element was redrawn before it landed dispatched nothing and is\nnot counted; the stall budget ends a page that keeps redrawing.",
          "title": "Max Steps"
        },
        "max_jev_calls": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Logical Jev evaluations. A retried request adds cost but not a call.",
          "title": "Max Jev Calls"
        },
        "max_llm_calls": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Llm Calls"
        },
        "max_dollars": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Bounds Jev and LLM spend as it happens. A cloud browser bills when it stops, after the run, so its\ncost is reported in the result but cannot stop the run that incurred it.",
          "title": "Max Dollars"
        },
        "max_seconds": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Stops active work at the time budget. Returning also waits for owned request and browser cleanup.",
          "title": "Max Seconds"
        }
      },
      "title": "Limits",
      "type": "object"
    },
    "LocalChrome": {
      "additionalProperties": false,
      "properties": {
        "binary": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "A name or path that replaces discovery of the Chrome binary.",
          "title": "Binary"
        },
        "headed": {
          "default": false,
          "description": "Show the window, to watch a run.",
          "title": "Headed",
          "type": "boolean"
        },
        "profile": {
          "anyOf": [
            {
              "format": "path",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "A profile directory kept between runs, so a site signed into there stays signed in. Without one,\nevery run starts from a fresh profile that is deleted afterwards.",
          "title": "Profile"
        }
      },
      "title": "LocalChrome",
      "type": "object"
    },
    "NoParams": {
      "additionalProperties": false,
      "properties": {},
      "title": "NoParams",
      "type": "object"
    },
    "Notification": {
      "description": "A message from the server that takes no reply. It has no `id` member at all, which is what marks it.",
      "properties": {
        "jsonrpc": {
          "const": "2.0",
          "default": "2.0",
          "title": "Jsonrpc",
          "type": "string"
        },
        "method": {
          "$ref": "#/$defs/ServerMethod"
        },
        "params": {
          "title": "Params"
        }
      },
      "required": [
        "jsonrpc",
        "method",
        "params"
      ],
      "title": "Notification",
      "type": "object"
    },
    "Operation": {
      "enum": [
        "click",
        "hover",
        "drag",
        "fill",
        "select",
        "enter",
        "escape",
        "scroll",
        "scroll_up",
        "back",
        "switch_tab",
        "upload",
        "dialog",
        "read",
        "done",
        "escalate",
        "navigate"
      ],
      "title": "Operation",
      "type": "string"
    },
    "Params": {
      "additionalProperties": false,
      "description": "A method's params. An unknown field is refused, so a misspelled option is never dropped in silence.",
      "properties": {},
      "title": "Params",
      "type": "object"
    },
    "Request": {
      "description": "A call in either direction. One without an id is a notification and gets no reply.",
      "properties": {
        "jsonrpc": {
          "const": "2.0",
          "default": "2.0",
          "title": "Jsonrpc",
          "type": "string"
        },
        "id": {
          "anyOf": [
            {
              "$ref": "#/$defs/RequestId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "method": {
          "title": "Method",
          "type": "string"
        },
        "params": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "items": {},
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Params"
        }
      },
      "required": [
        "jsonrpc",
        "id",
        "method",
        "params"
      ],
      "title": "Request",
      "type": "object"
    },
    "RequestId": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "string"
        }
      ]
    },
    "Response": {
      "properties": {
        "jsonrpc": {
          "const": "2.0",
          "default": "2.0",
          "title": "Jsonrpc",
          "type": "string"
        },
        "id": {
          "$ref": "#/$defs/RequestId"
        },
        "result": {
          "title": "Result"
        }
      },
      "required": [
        "jsonrpc",
        "id",
        "result"
      ],
      "title": "Response",
      "type": "object"
    },
    "RunAttachment": {
      "additionalProperties": false,
      "description": "An `Attachment` as it travels: JSON has no bytes, so the content is base64.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "mime_type": {
          "title": "Mime Type",
          "type": "string"
        },
        "content": {
          "format": "base64",
          "title": "Content",
          "type": "string"
        }
      },
      "required": [
        "name",
        "mime_type",
        "content"
      ],
      "title": "RunAttachment",
      "type": "object"
    },
    "RunCancelParams": {
      "additionalProperties": false,
      "description": "Which run to stop. One that is not active, because it finished or never was, is left as it is.\n\nThe reply says only that the request was read. The run's own reply is what says it was cancelled: the\n`cancelled` error, written after its browser has closed.",
      "properties": {
        "run_id": {
          "title": "Run Id",
          "type": "string"
        }
      },
      "required": [
        "run_id"
      ],
      "title": "RunCancelParams",
      "type": "object"
    },
    "RunEvent": {
      "description": "The params of `run/event`: one thing a run did, written before that run's reply.",
      "properties": {
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "event": {
          "anyOf": [
            {
              "$ref": "#/$defs/StepEvent"
            },
            {
              "$ref": "#/$defs/BrowserEvent"
            }
          ],
          "title": "Event"
        }
      },
      "required": [
        "run_id",
        "event"
      ],
      "title": "RunEvent",
      "type": "object"
    },
    "RunFrame": {
      "description": "The params of `run/frame`: the active tab as it looked a moment ago. Sent only to a run that set `frames`.",
      "properties": {
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "frame": {
          "title": "Frame",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "frame"
      ],
      "title": "RunFrame",
      "type": "object"
    },
    "RunParams": {
      "additionalProperties": false,
      "description": "One run: the run's arguments, and what the server needs to talk to the client about it.\n\nThe reply is the `RunResult`. No API key is among the fields: model and browser keys come from the\nenvironment the server inherited.",
      "properties": {
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "secrets": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SecretRef"
          },
          "title": "Secrets",
          "type": "array"
        },
        "frames": {
          "default": false,
          "title": "Frames",
          "type": "boolean"
        },
        "until": {
          "default": false,
          "title": "Until",
          "type": "boolean"
        },
        "task": {
          "title": "Task",
          "type": "string"
        },
        "start": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start"
        },
        "context": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Context"
        },
        "inputs": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Inputs"
        },
        "attachments": {
          "default": [],
          "items": {
            "$ref": "#/$defs/RunAttachment"
          },
          "title": "Attachments",
          "type": "array"
        },
        "limits": {
          "anyOf": [
            {
              "$ref": "#/$defs/Limits"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "authorization": {
          "anyOf": [
            {
              "$ref": "#/$defs/Authorization"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "output_schema": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Schema"
        },
        "downloads": {
          "anyOf": [
            {
              "format": "path",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Downloads"
        },
        "record": {
          "anyOf": [
            {
              "format": "path",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Record"
        },
        "cursor": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cursor"
        },
        "local": {
          "default": false,
          "title": "Local",
          "type": "boolean"
        },
        "chrome": {
          "anyOf": [
            {
              "$ref": "#/$defs/LocalChrome"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "cloud_profile": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cloud Profile"
        },
        "cdp_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cdp Url"
        },
        "cdp_port": {
          "anyOf": [
            {
              "maximum": 65535,
              "minimum": 0,
