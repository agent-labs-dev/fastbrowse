# Copy to .env and fill in. A real environment variable wins over this file.

# Jev and the LLM that plans, reads and writes answers: this key is enough for both.
OPENROUTER_API_KEY=            # https://openrouter.ai/keys

# Optional Jev backup and alternative source.
# AI_GATEWAY_API_KEY=          # Vercel AI Gateway: Jev backup, and the LLM without OpenRouter, https://vercel.com/ai-gateway
# TYPESAFE_API_KEY=            # Jev directly; takes precedence when set, https://typesafe.ai
# FASTBROWSE_JEV_SOURCE=openrouter # typesafe, openrouter or gateway; overrides automatic key precedence
# FASTBROWSE_JEV_BASE_URL=         # a proxy serving that source's API; disables failover
# FASTBROWSE_JEV_MODEL=jev-1.13    # OpenRouter or direct API only; an explicit pin disables failover
# Model defaults and routing rules: docs/jev.md.

# A Browser Use Cloud browser: the default for runs (--local uses Chrome instead) and the live evals.
# BROWSER_USE_API_KEY=         # https://cloud.browser-use.com

# Optional: models and reasoning. Defaults are in src/fastbrowse/clients/environment.py.
# FASTBROWSE_LLM_MODEL=google/gemini-3.8-flash      # every purpose
# FASTBROWSE_LLM_MODEL_PLAN=                        # or one purpose: PLAN, READ, FIELD_TEXT,
# FASTBROWSE_LLM_MODEL_READ=                        # SHORTCUT, RECOVER, COMPOSE, VERIFY
# FASTBROWSE_LLM_REASONING=low                      # low, medium or high

# Optional: local Chrome. The binary, when it is not on PATH under a usual name:
# FASTBROWSE_CHROME=/usr/bin/chromium
# Either of these runs local Chrome, as --local does, and refuses --cloud-profile:
# FASTBROWSE_HEADED=1                              # show the window
# FASTBROWSE_PROFILE=~/.fastbrowse/default         # keep the profile between runs

# Values for --secret NAME=ENV_VAR are read from the process environment, not this file.

# Optional: fastbrowse-mcp over HTTP. Every request but /healthz must carry it as a bearer token.
# FASTBROWSE_MCP_TOKEN=
