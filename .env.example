# Copy to .env and fill in. A real environment variable wins over this file.

# Jev (recommended) and the LLM. Direct TypeSafe is the recommended Jev route and the only route that may
# receive Jev image input; OpenRouter is supported for Jev text but is not recommended. The LLM uses
# OPENROUTER_API_KEY, or the Vercel AI Gateway below when that key is absent.
TYPESAFE_API_KEY=             # Jev directly, recommended, https://typesafe.ai
OPENROUTER_API_KEY=           # the LLM, and a supported Jev text route, https://openrouter.ai/keys

# Optional. AI_GATEWAY_API_KEY serves the LLM when OpenRouter is absent. A gateway key on its own also serves
# Jev, as a last resort rather than the recommended Jev route. OpenRouter never receives Jev image input.
# AI_GATEWAY_API_KEY=          # Vercel AI Gateway, https://vercel.com/ai-gateway
# FASTBROWSE_DECISION_SOURCE=typesafe   # typesafe, openrouter or gateway; overrides automatic key precedence
# FASTBROWSE_DECISION_BASE_URL=         # a proxy serving that source's API; disables failover
# FASTBROWSE_DECISION_MODEL=jev-1.13    # OpenRouter or direct API only; an explicit pin disables failover
# Another System One host instead of a Jev source; each gets only its own key (docs/jev.md):
# FASTBROWSE_DECISION_SOURCE=telnyx     # telnyx, openai, perplexity, aimlapi, ollama or custom
# TELNYX_API_KEY=                       # for telnyx
# OPENAI_API_KEY=                       # for openai
# PERPLEXITY_API_KEY=                   # for perplexity
# AIMLAPI_API_KEY=                      # for aimlapi
# FASTBROWSE_DECISION_API_KEY=          # for ollama or custom, when the host takes one
# Model defaults and routing rules: docs/jev.md.

# A Browser Use Cloud browser: the default for runs (--local uses Chrome instead) and the live evals.
# BROWSER_USE_API_KEY=         # https://cloud.browser-use.com

# Optional: models and reasoning. Defaults are in crates/fastbrowse-clients/src/environment.rs.
# FASTBROWSE_LLM_MODEL=google/gemini-3.8-flash      # every purpose
# FASTBROWSE_LLM_MODEL_PLAN=                        # or one purpose: PLAN, READ, FIELD_TEXT,
# FASTBROWSE_LLM_MODEL_READ=                        # SHORTCUT, RECOVER, COMPOSE, VERIFY
# FASTBROWSE_LLM_REASONING=low                      # none, low, medium or high
# FASTBROWSE_LLM_REASONING_VERIFY=none              # one purpose's effort, as FASTBROWSE_LLM_MODEL_<PURPOSE>
# Point every LLM call at any OpenAI-compatible chat completions endpoint instead of OpenRouter and
# the Vercel AI Gateway (for example a local vLLM server). Requires FASTBROWSE_LLM_MODEL to name the
# served model; FASTBROWSE_LLM_API_KEY is optional and only sent when set. The two settings after it
# shape requests to this endpoint only.
# FASTBROWSE_LLM_BASE_URL=http://127.0.0.1:8000/v1
# FASTBROWSE_LLM_API_KEY=
# FASTBROWSE_LLM_STRICT=0                   # some local vLLM builds mangle strict structured output
# Extra request parameters some endpoints need (for example a Qwen whose reasoning stream breaks
# structured output): FASTBROWSE_LLM_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}

# Optional: local Chrome. The binary, when it is not on PATH under a usual name:
# FASTBROWSE_CHROME=/usr/bin/chromium
# Either of these runs local Chrome, as --local does, and refuses --cloud-profile:
# FASTBROWSE_HEADED=1                              # show the window
# FASTBROWSE_PROFILE=~/.fastbrowse/default         # keep the profile between runs

# Values for --secret NAME=ENV_VAR are read from the process environment, not this file.

# Optional: fastbrowse-mcp over HTTP. Every request but /healthz must carry it as a bearer token.
# FASTBROWSE_MCP_TOKEN=
