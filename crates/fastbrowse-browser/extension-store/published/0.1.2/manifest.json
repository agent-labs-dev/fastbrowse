{
  "manifest_version": 3,
  "name": "fastbrowse",
  "description": "Run fastbrowse tasks in the Chrome you already use, where you are signed in. Requires the fastbrowse CLI.",
  "version": "0.1.2",
  "minimum_chrome_version": "125",
  "homepage_url": "https://www.fastbrowse.ai/",
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "permissions": [
    "debugger",
    "tabs",
    "tabGroups",
    "nativeMessaging",
    "storage",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "fastbrowse",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png"
    }
  }
}
