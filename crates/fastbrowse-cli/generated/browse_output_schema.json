    "final_url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Final Url"
    },
    "live_url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Live Url"
    },
    "steps": {
      "title": "Steps",
      "type": "integer"
    },
    "dollars": {
      "title": "Dollars",
      "type": "number"
    },
    "cost_complete": {
      "title": "Cost Complete",
      "type": "boolean"
    },
    "downloads": {
      "items": {
        "$ref": "#/$defs/Download"
      },
      "title": "Downloads",
      "type": "array"
